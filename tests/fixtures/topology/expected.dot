digraph stores_topology {
  rankdir=TB;
  compound=true;

  subgraph cluster_z0_cross_store {
    label="Z0: cross-store soft-FKs";
    "z0_tasks" [shape=box, label="tasks"];
    "z0_observations" [shape=box, label="observations"];
    "z0_gate" [shape=box, label="gate"];
    "z0_tasks" -> "z0_tasks" [label="depends_on"];
    "z0_tasks" -> "z0_observations" [label="linked_observations"];
  }

  subgraph cluster_z1_tasks {
    label="Z1: tasks state machine";
    "z1_tasks__queued" [label="queued"];
    "z1_tasks__active" [label="active"];
    "z1_tasks__integration" [label="integration"];
    "z1_tasks__done" [label="done"];
    "z1_tasks__planning" [label="planning", style=bold, peripheries=2];
    "z1_tasks__plan_review" [label="plan_review"];
    "z1_tasks__ready" [label="ready"];
    "z1_tasks__executing" [label="executing"];
    "z1_tasks__code_review" [label="code_review"];
    "z1_tasks__blocked" [label="blocked"];
    "z1_tasks__complete" [label="complete"];
    "z1_tasks__in_review" [label="in_review"];
    "z1_tasks__accepted" [label="accepted"];
    "z1_tasks__rejected" [label="rejected"];
    "z1_tasks__integration_queued" [label="integration_queued"];
    "z1_tasks__integrating" [label="integrating"];
    "z1_tasks__integration_blocked" [label="integration_blocked"];
    "z1_tasks__integrated" [label="integrated"];
    "z1_tasks__closed_out_of_band" [label="closed_out_of_band"];
    "z1_tasks__abandoned" [label="abandoned"];
    "z1_tasks__planning" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__plan_review" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__ready" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__executing" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__code_review" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__blocked" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__complete" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__in_review" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__rejected" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__integration_queued" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__integrating" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__integration_blocked" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__integrated" -> "z1_tasks__closed_out_of_band" [label=" H!\nclose-out-of-band", color=red, fontcolor=red];
    "z1_tasks__planning" -> "z1_tasks__planning" [label=" F\nactivate-task", color=gray, fontcolor=gray];
    "z1_tasks__planning" -> "z1_tasks__planning" [label=" F\nrelease-from-queued", color=gray, fontcolor=gray];
    "z1_tasks__planning" -> "z1_tasks__plan_review" [label=" A\nsubmit-plan", color=green, fontcolor=green];
    "z1_tasks__planning" -> "z1_tasks__ready" [label=" F\nskip-plan", color=gray, fontcolor=gray];
    "z1_tasks__plan_review" -> "z1_tasks__ready" [label=" A\nsubmit-plan-review\n[READY]", color=green, fontcolor=green];
    "z1_tasks__plan_review" -> "z1_tasks__planning" [label=" A\nsubmit-plan-review\n[NEEDS_WORK]", color=green, fontcolor=green];
    "z1_tasks__plan_review" -> "z1_tasks__blocked" [label=" A\nsubmit-plan-review\n[NEEDS_WORK]", color=green, fontcolor=green];
    "z1_tasks__plan_review" -> "z1_tasks__blocked" [label=" A\nsubmit-plan-review\n[NOT_READY]", color=green, fontcolor=green];
    "z1_tasks__ready" -> "z1_tasks__executing" [label=" F\nstart", color=gray, fontcolor=gray];
    "z1_tasks__executing" -> "z1_tasks__code_review" [label=" A\nsubmit-execute", color=green, fontcolor=green];
    "z1_tasks__code_review" -> "z1_tasks__executing" [label=" A\nsubmit-review\n[PASS]", color=green, fontcolor=green];
    "z1_tasks__code_review" -> "z1_tasks__complete" [label=" A\nsubmit-review\n[PASS]", color=green, fontcolor=green];
    "z1_tasks__code_review" -> "z1_tasks__executing" [label=" A\nsubmit-review\n[REVISE]", color=green, fontcolor=green];
    "z1_tasks__code_review" -> "z1_tasks__blocked" [label=" A\nsubmit-review\n[REVISE]", color=green, fontcolor=green];
    "z1_tasks__code_review" -> "z1_tasks__blocked" [label=" A\nsubmit-review\n[FAIL]", color=green, fontcolor=green];
    "z1_tasks__blocked" -> "z1_tasks__planning" [label=" H+\nresume", color=gold, fontcolor=gold];
    "z1_tasks__planning" -> "z1_tasks__blocked" [label=" F\nmark_drive_failed", color=gray, fontcolor=gray];
    "z1_tasks__plan_review" -> "z1_tasks__blocked" [label=" F\nmark_drive_failed", color=gray, fontcolor=gray];
    "z1_tasks__ready" -> "z1_tasks__blocked" [label=" F\nmark_drive_failed", color=gray, fontcolor=gray];
    "z1_tasks__executing" -> "z1_tasks__blocked" [label=" F\nmark_drive_failed", color=gray, fontcolor=gray];
    "z1_tasks__code_review" -> "z1_tasks__blocked" [label=" F\nmark_drive_failed", color=gray, fontcolor=gray];
    "z1_tasks__accepted" -> "z1_tasks__integration_queued" [label=" F\nenqueue-integration", color=gray, fontcolor=gray];
    "z1_tasks__integration_queued" -> "z1_tasks__integrating" [label=" F\nstart-integration", color=gray, fontcolor=gray];
    "z1_tasks__integrating" -> "z1_tasks__integrating" [label=" F\nmark_refresh_done", color=gray, fontcolor=gray];
    "z1_tasks__integrating" -> "z1_tasks__integrating" [label=" F\nmark_task_review_done", color=gray, fontcolor=gray];
    "z1_tasks__integrating" -> "z1_tasks__integrating" [label=" F\nmark_testing_done", color=gray, fontcolor=gray];
    "z1_tasks__integrating" -> "z1_tasks__integrating" [label=" F\nmark_merge_done", color=gray, fontcolor=gray];
    "z1_tasks__integrating" -> "z1_tasks__integrating" [label=" F\nmark_deploy_done", color=gray, fontcolor=gray];
    "z1_tasks__integrating" -> "z1_tasks__integrated" [label=" F\nmark_verify_done", color=gray, fontcolor=gray];
    "z1_tasks__integrating" -> "z1_tasks__integrated" [label=" F\nmark_integrated", color=gray, fontcolor=gray];
    "z1_tasks__integrating" -> "z1_tasks__integration_blocked" [label=" F\nmark_integration_blocked", color=gray, fontcolor=gray];
    "z1_tasks__integration_blocked" -> "z1_tasks__integration_queued" [label=" H+\nretry-integration", color=gold, fontcolor=gold];
    "z1_tasks__complete" -> "z1_tasks__in_review" [label=" F\nrequest_review", color=gray, fontcolor=gray];
    "z1_tasks__in_review" -> "z1_tasks__executing" [label=" F\nsubmit-external-review\n[REVISE]", color=gray, fontcolor=gray];
    "z1_tasks__in_review" -> "z1_tasks__accepted" [label=" H!\naccept", color=red, fontcolor=red];
    "z1_tasks__complete" -> "z1_tasks__integration_queued" [label=" F\nrelease-to-integration", color=gray, fontcolor=gray];
    "z1_tasks__in_review" -> "z1_tasks__integration_queued" [label=" F\nrelease-to-integration", color=gray, fontcolor=gray];
    "z1_tasks__accepted" -> "z1_tasks__integration_queued" [label=" F\nrelease-to-integration", color=gray, fontcolor=gray];
    "z1_tasks__in_review" -> "z1_tasks__rejected" [label=" H!\nreject", color=red, fontcolor=red];
    "z1_tasks__rejected" -> "z1_tasks__planning" [label=" H+\namend", color=gold, fontcolor=gold];
    "z1_tasks__planning" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
    "z1_tasks__plan_review" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
    "z1_tasks__ready" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
    "z1_tasks__executing" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
    "z1_tasks__code_review" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
    "z1_tasks__blocked" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
    "z1_tasks__in_review" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
    "z1_tasks__complete" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
    "z1_tasks__integration_queued" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
    "z1_tasks__integrating" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
    "z1_tasks__integration_blocked" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
    "z1_tasks__integrated" -> "z1_tasks__abandoned" [label=" H!\nabandon", color=red, fontcolor=red];
  }

  subgraph cluster_z1_observations {
    label="Z1: observations state machine";
    "z1_observations__open" [label="open", style=bold, peripheries=2];
    "z1_observations__needs_investigation" [label="needs_investigation"];
    "z1_observations__investigating" [label="investigating"];
    "z1_observations__investigated" [label="investigated"];
    "z1_observations__investigation_failed" [label="investigation_failed"];
    "z1_observations__confirmed" [label="confirmed"];
    "z1_observations__ready" [label="ready"];
    "z1_observations__needs_info" [label="needs_info"];
    "z1_observations__in_progress" [label="in_progress"];
    "z1_observations__resolved" [label="resolved"];
    "z1_observations__wont_fix" [label="wont_fix"];
    "z1_observations__open" -> "z1_observations__investigating" [label=" A\ninvestigate", color=green, fontcolor=green];
    "z1_observations__open" -> "z1_observations__needs_investigation" [label=" H+\nrequest-investigation", color=gold, fontcolor=gold];
    "z1_observations__needs_investigation" -> "z1_observations__investigating" [label=" F\ninvestigation-started", color=gray, fontcolor=gray];
    "z1_observations__investigating" -> "z1_observations__investigated" [label=" F\ninvestigation-succeeded", color=gray, fontcolor=gray];
    "z1_observations__investigating" -> "z1_observations__investigation_failed" [label=" F\ninvestigation-failed", color=gray, fontcolor=gray];
    "z1_observations__open" -> "z1_observations__wont_fix" [label=" H+\nwont_fix", color=gold, fontcolor=gold];
    "z1_observations__open" -> "z1_observations__resolved" [label=" A\nclose_as_addressed", color=green, fontcolor=green];
    "z1_observations__ready" -> "z1_observations__resolved" [label=" A\nclose_as_addressed", color=green, fontcolor=green];
    "z1_observations__investigating" -> "z1_observations__confirmed" [label=" H+\nconfirm", color=gold, fontcolor=gold];
    "z1_observations__confirmed" -> "z1_observations__ready" [label=" F\nratify", color=gray, fontcolor=gray];
    "z1_observations__investigating" -> "z1_observations__needs_info" [label=" A\nrequest_info", color=green, fontcolor=green];
    "z1_observations__confirmed" -> "z1_observations__needs_info" [label=" A\npark", color=green, fontcolor=green];
    "z1_observations__needs_info" -> "z1_observations__confirmed" [label=" H!\nprovide_info", color=red, fontcolor=red];
    "z1_observations__confirmed" -> "z1_observations__in_progress" [label=" A\nclaim", color=green, fontcolor=green];
    "z1_observations__in_progress" -> "z1_observations__resolved" [label=" A\nresolve", color=green, fontcolor=green];
    "z1_observations__confirmed" -> "z1_observations__wont_fix" [label=" H+\nwont_fix", color=gold, fontcolor=gold];
    "z1_observations__ready" -> "z1_observations__wont_fix" [label=" H+\nwont_fix", color=gold, fontcolor=gold];
    "z1_observations__open" -> "z1_observations__resolved" [label=" F\nauto_resolve", color=gray, fontcolor=gray];
    "z1_observations__investigating" -> "z1_observations__resolved" [label=" F\nauto_resolve", color=gray, fontcolor=gray];
    "z1_observations__confirmed" -> "z1_observations__resolved" [label=" F\nauto_resolve", color=gray, fontcolor=gray];
    "z1_observations__ready" -> "z1_observations__resolved" [label=" F\nauto_resolve", color=gray, fontcolor=gray];
    "z1_observations__needs_info" -> "z1_observations__resolved" [label=" F\nauto_resolve", color=gray, fontcolor=gray];
    "z1_observations__in_progress" -> "z1_observations__resolved" [label=" F\nauto_resolve", color=gray, fontcolor=gray];
  }

  subgraph cluster_z1_gate {
    label="Z1: gate state machine";
    "z1_gate__pending" [label="pending", style=bold, peripheries=2];
    "z1_gate__answered" [label="answered"];
    "z1_gate__deferred" [label="deferred"];
    "z1_gate__cancelled" [label="cancelled"];
    "z1_gate__pending" -> "z1_gate__answered" [label=" H!\nanswer", color=red, fontcolor=red];
    "z1_gate__pending" -> "z1_gate__cancelled" [label=" A\ncancel", color=green, fontcolor=green];
    "z1_gate__deferred" -> "z1_gate__cancelled" [label=" A\ncancel", color=green, fontcolor=green];
    "z1_gate__pending" -> "z1_gate__deferred" [label=" H+\ndefer", color=gold, fontcolor=gold];
    "z1_gate__deferred" -> "z1_gate__pending" [label=" H+\nresume", color=gold, fontcolor=gold];
    "z1_gate__pending" -> "z1_gate__pending" [label=" H+\nresume", color=gold, fontcolor=gold];
  }

  subgraph cluster_z2_workflow_tasks {
    label="Z2: tasks workflow firing order";
    "z2_tasks__planning" [label="planning"];
    "z2_tasks__planning__role_0_planner" [shape=ellipse, label="planner"];
    "z2_tasks__planning" -> "z2_tasks__planning__role_0_planner" [label="→ planner", color=green, fontcolor=green];
    "z2_tasks__ready" [label="ready"];
    "z2_tasks__planning" -> "z2_tasks__ready" [label="⇒ auto", color=gray, fontcolor=gray];
    "z2_tasks__plan_review" [label="plan_review"];
    "z2_tasks__plan_review__role_0_plan_reviewer" [shape=ellipse, label="plan_reviewer"];
    "z2_tasks__plan_review" -> "z2_tasks__plan_review__role_0_plan_reviewer" [label="→ plan_reviewer", color=green, fontcolor=green];
    "z2_tasks__ready" [label="ready"];
    "z2_tasks__executing" [label="executing"];
    "z2_tasks__ready" -> "z2_tasks__executing" [label="⇒ auto", color=gray, fontcolor=gray];
    "z2_tasks__executing" [label="executing"];
    "z2_tasks__executing__role_0_executor" [shape=ellipse, label="executor"];
    "z2_tasks__executing" -> "z2_tasks__executing__role_0_executor" [label="→ executor", color=green, fontcolor=green];
    "z2_tasks__code_review" [label="code_review"];
    "z2_tasks__code_review__role_0_code_reviewer" [shape=ellipse, label="code_reviewer"];
    "z2_tasks__code_review" -> "z2_tasks__code_review__role_0_code_reviewer" [label="→ code_reviewer", color=green, fontcolor=green];
    "z2_tasks__complete" [label="complete"];
    "z2_tasks__in_review" [label="in_review"];
    "z2_tasks__complete" -> "z2_tasks__in_review" [label="⇒ auto", color=gray, fontcolor=gray];
    "z2_tasks__in_review" [label="in_review"];
    "z2_tasks__in_review__role_0_wrap" [shape=ellipse, label="wrap"];
    "z2_tasks__in_review" -> "z2_tasks__in_review__role_0_wrap" [label="→ wrap", color=green, fontcolor=green];
  }

}
