{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stores.local/schemas/investigator",
  "title": "InvestigatorEnvelope",
  "description": "Pull-shaped evidence brief produced by the investigator subagent. The investigator outputs evidence for the human to prune, NOT a draft contract. Forbidden fields (draft_contract, intent_contract, done_when, scope_in, scope_out, acceptance, objective) are mechanically rejected.",
  "type": "object",
  "required": [
    "evidence",
    "duplicate_candidates",
    "confidence",
    "proposed_tier",
    "grill_question"
  ],
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "type": "array",
      "description": "Citable refs supporting the observation. Each item is either a free-form string or an object with file/line/snippet.",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["file"],
            "additionalProperties": false,
            "properties": {
              "file": {"type": "string"},
              "line": {"type": "integer"},
              "snippet": {"type": "string"}
            }
          }
        ]
      }
    },
    "duplicate_candidates": {
      "type": "array",
      "description": "Possible duplicate observations with similarity reasons.",
      "items": {
        "type": "object",
        "required": ["l_id", "similarity_reason"],
        "additionalProperties": false,
        "properties": {
          "l_id": {
            "type": "string",
            "pattern": "^L\\d{3,}$",
            "description": "Substrate observation display id; matches /^L\\d{3,}$/."
          },
          "similarity_reason": {"type": "string"}
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Investigator's confidence the observation is real."
    },
    "proposed_tier": {
      "type": "string",
      "enum": ["T0", "T1", "T2", "T3"],
      "description": "Suggested tier (advisory, not authoritative — human decides)."
    },
    "grill_question": {
      "type": "string",
      "maxLength": 200,
      "description": "One tight question the human should consider before ratifying."
    },
    "harden_log_fragment": {
      "type": "object",
      "description": "Optional bounded derivation audit fragment for observations.intent_contract.harden_log; not a draft contract and not transcript-like chain-of-thought.",
      "additionalProperties": false,
      "properties": {
        "decisions": {"type": "array", "items": {"type": "object", "required": ["id", "decision", "rationale"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "decision": {"type": "string"}, "rationale": {"type": "string"}, "source_quote": {"type": "string"}}}},
        "scope_cuts": {"type": "array", "items": {"type": "object", "required": ["cut", "rationale"], "additionalProperties": false, "properties": {"cut": {"type": "string"}, "rationale": {"type": "string"}, "source_quote": {"type": "string"}}}},
        "alternatives_rejected": {"type": "array", "items": {"type": "object", "required": ["alternative", "why_rejected"], "additionalProperties": false, "properties": {"alternative": {"type": "string"}, "why_rejected": {"type": "string"}}}},
        "compress_vs_surface": {"type": "array", "items": {"type": "object", "required": ["item", "judgment", "rationale"], "additionalProperties": false, "properties": {"item": {"type": "string"}, "judgment": {"type": "string"}, "rationale": {"type": "string"}}}},
        "unresolved_questions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
